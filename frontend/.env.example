# ── Klucze API (opcjonalne) ─────────────────────────────────────────────
# Aplikacja działa w pełni na danych mockowych bez kluczy API.
# Ustaw je tylko jeśli chcesz pobierać rzeczywiste dane.

# OpenWeatherMap – pogoda, wschód/zachód słońca
# https://openweathermap.org/api
# OWM_API_KEY=

# Airly – jakość powietrza
# https://developer.airly.org
# AIRLY_API_KEY=

# Sentry – monitorowanie błędów (VITE_ prefiks – działa tylko w budowaniu Vite)
# https://sentry.io
# VITE_SENTRY_DSN=

# ── Asystent AI (opcjonalny) ────────────────────────────────────────────
# Jeśli nie ustawisz tych zmiennych, asystent działa w trybie rules-based
# (offline, bez zewnętrznego API). Ustaw je, aby użyć modelu LLM.

# Klucz API do zewnętrznego modelu językowego
# AI_API_KEY=

# Nazwa modelu (domyślnie: gpt-3.5-turbo)
# AI_MODEL=gpt-3.5-turbo

# URL endpointu API (domyślnie: https://api.openai.com/v1/chat/completions)
# Dla Ollama lokalnie: http://localhost:11434/v1/chat/completions
# AI_API_URL=https://api.openai.com/v1/chat/completions

# ── Konfiguracja serwera (opcjonalnie) ──────────────────────────────────
# Port na którym serwer Express ma nasłuchiwać (domyślnie: 3001)
# PORT=3001
